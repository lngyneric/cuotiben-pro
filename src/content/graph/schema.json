  "date": "2026-11-19",
  "note": "类、属性、规则沿用入社培训本体框架的写法；规则编号用 G1–G9，与入社培训的 R1–R10 区分。全文见 docs/wiki-graph-ontology.md。",
  "object_properties": [
    {
      "domain": "Domain",
      "example": "通识基础 —包含节点→ 六大检验系统总览",
      "id": "domainHasNode",
      "inverse": "属于领域",
      "label": "领域包含节点",
      "range": "KnowledgeNode"
    },
    {
      "domain": "KnowledgeNode",
      "example": "血液检验基础 —挂课程→ 血液检验基础——从血细胞到智能流水线",
      "id": "nodeHasCourse",
      "inverse": "属于节点",
      "label": "节点挂课程",
      "range": "Course"
    },
    {
      "domain": "KnowledgeNode",
      "example": "六大检验系统总览 —挂文档→ 入职前准备（新人入学类挂领域级，见 domainHasDoc）",
      "id": "nodeHasDoc",
      "inverse": "挂在节点下",
      "label": "节点挂文档",
      "range": "DocSection"
    },
    {
      "domain": "Domain",
      "example": "通识基础 —挂文档→ 00 开始这里：第一周导航（分类=新人入学）",
      "id": "domainHasDoc",
      "inverse": "挂在领域下",
      "label": "领域挂文档",
      "range": "DocSection"
    },
    {
      "domain": "KnowledgeNode",
      "example": "凝血检验基础 —先修→ 血液检验基础",
      "id": "nodePrerequisite",
      "inverse": "是……的先修",
      "label": "先修",
      "range": "KnowledgeNode"
    },
    {
      "domain": "KnowledgeNode",
      "example": "血液检验基础 —进阶→ 血液形态学",
      "id": "nodeExtends",
      "inverse": "进阶自",
      "label": "进阶",
      "range": "KnowledgeNode"
    },
    {
      "domain": "KnowledgeNode",
      "example": "血液质控 —并行→ 生化检验基础（质控体系通用）",
      "id": "nodeParallel",
      "inverse": "并行",
      "label": "并行",
      "range": "KnowledgeNode"
    },
    {
      "domain": "RoleView",
