  "ontology": "Wiki 知识图谱本体",
  "rules": [
    {
      "id": "G1",
      "on_violation": "列出孤儿节点，先补领域归属再发布",
      "rule": "每个节点必须属于恰好一个领域；领域不存在即校验不过",
      "source": "TREE domains 展开"
    },
    {
      "id": "G2",
      "on_violation": "标“未入库”进清单，不静默丢掉",
      "rule": "每个课程 shifu_bid 必须映射到一个 wiki post slug，或明确标“未入库”",
      "source": "post 表 slug course-<bid>"
    },
    {
      "id": "G3",
      "on_violation": "列出悬空边，先修数据再发布",
      "rule": "每条边的两端节点必须存在；悬空边即校验不过",
      "source": "graph.json 边表"
    },
    {
      "id": "G4",
      "on_violation": "角色视图缺节点先补定义，不要空视图上线",
      "rule": "角色视图只引用已存在的领域／节点；三档（销售／应用／客服）齐全且非空",
      "source": "docs/wiki-graph-ontology.md 第 3 节"
    },
    {
      "id": "G5",
      "on_violation": "进未匹配清单，不删除、不猜",
      "rule": "文档 section 必须挂到领域或节点；匹配不上标“未匹配”",
      "source": "4.2 文档挂接规则"
    },
    {
      "id": "G6",
      "on_violation": "去重后再生成",
      "rule": "同一 shifu_bid 全图只出现一次",
      "source": "TREE courses 去重"
    },
    {
      "id": "G7",
      "on_violation": "改 id 后重生成",
      "rule": "节点 id 全局唯一",
      "source": "graph.json 节点表"
    },
    {
      "id": "G8",
      "on_violation": "补生成时间与 TREE 版本再发布",
      "rule": "图谱必须带 generatedAt 与 treeVersion",
      "source": "build_wiki_graph.py"
    },
    {
      "id": "G9",
      "on_violation": "改回实测状态再发布",
      "rule": "SharePoint 候选只记实测到的元数据；未抽取全文的不得标“全文已抽”",
      "source": "docs/wiki-graph-ontology.md 第 5 节"
    }
  ],
  "scope": "IVD 检验医学知识体系（TREE 骨架）＋ wiki 课程与文档；首批领域轴＋角色剪裁",
  "source_document": "TREE v1.0.1（2026-09-21 生成）＋ docs/wiki-graph-ontology.md",
  "version": "1.0"
}
