# Intranet deployment env for the cuotiben-pro blog (eu.sysmex.com.cn/wiki/).
# Copy to .env.intranet on the server and fill in the real values.
# .env.intranet is gitignored AND dockerignored — it must never be committed
# or baked into the image (it holds AUTH_SECRET).
#
# NOTE: APP_BASE_PATH / VITE_APP_URL / VITE_AAD_LOGIN_ENABLED are BUILD-time
# public values — they are baked into the bundle via docker-compose build
# args. Changing them here alone does nothing; rebuild the image.

# Public app URL (must end with /wiki; also used for canonical links).
VITE_APP_URL=https://eu.sysmex.com.cn/wiki
# better-auth base URL (must match VITE_APP_URL).
AUTH_URL=https://eu.sysmex.com.cn/wiki
# Extra origins allowed to call the auth API (comma-separated).
AUTH_TRUSTED_ORIGINS=eu.sysmex.com.cn
# Session cookie prefix — distinct from ai-shifu's so the two apps sharing
# eu.sysmex.com.cn never overwrite each other's session cookie.
AUTH_COOKIE_PREFIX=cuotiben_wiki_
# Generate with: openssl rand -base64 32. REQUIRED in production — the app
# refuses to start with the placeholder secret.
AUTH_SECRET=CHANGE-ME-openssl-rand-base64-32

# Sub-path mount. Keep in sync with the build arg in
# docker-compose.intranet.yml (build-time) — runtime value is read by the
# server for Paraglide redirects and storage URL building.
APP_BASE_PATH=/wiki
# Show the "工号登录" form on the sign-in page (build-time public flag).
VITE_AAD_LOGIN_ENABLED=true

# Database: SQLite file inside the /app/data volume.
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:/app/data/blog.db

# Internal enterprise AAD server (NOT Microsoft Entra).
AAD_AUTH_URL=http://10.40.20.195:8082
# The AAD host must bypass any egress proxy. Node's fetch does not read
# proxy env vars (the call goes direct), but keep this for curl/debugging
# and any proxy-aware tooling on the host.
NO_PROXY=10.40.20.195,localhost,127.0.0.1
no_proxy=10.40.20.195,localhost,127.0.0.1

# Blog HTML local storage: HTML files on disk, metadata in SQLite.
BLOG_HTML_DIR=/app/data/blog-html
