{
  "classes": [
    {
      "definition": "TREE 的 13 个检验／商务领域",
      "id": "Domain",
      "label": "领域",
      "subclasses": []
    },
    {
      "definition": "TREE 的知识节点（原样保留难度、学时、仪器、参数、关键主题）",
      "id": "KnowledgeNode",
      "label": "知识节点",
      "subclasses": []
    },
    {
      "definition": "节点下的课程，shifu_bid 对 wiki post（course-<bid>）",
      "id": "Course",
      "label": "课程",
      "subclasses": []
    },
    {
      "definition": "doc-index.json 里的文档章节（已上传 HTML 文档的 section）",
      "id": "DocSection",
      "label": "文档章节",
      "subclasses": []
    },
    {
      "definition": "同一张图的三种剪裁（销售／应用／客服），不复制节点",
      "id": "RoleView",
      "label": "角色视图",
      "subclasses": ["销售", "应用", "客服"]
    },
    {
      "definition": "TREE learning_paths 的带教路径（阶段轴第二批用；首批只记节点归属）",
      "id": "LearningPath",
      "label": "带教路径",
      "subclasses": []
    },
    {
      "definition": "SharePoint 抽取的锚点：站点与文档库；首批只含已验证的 ZLSW 站点＋Documents 库，全文抽取状态一律记“未抽取”",
      "id": "SharePointSource",
      "label": "SharePoint 源",
      "subclasses": ["站点", "文档库"]
    }
  ],
